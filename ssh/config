#######
# All #
#######

# Sets the correct TERM value
Host *
  SetEnv TERM=xterm-256color

  # Allows to connect directly to tmux (session name is after the '-')
Host *-*
  RequestTTY yes
  RemoteCommand tmux -u new-session -A -s ${%n} \; set-option status-bg brightcyan


  #########
  # local #
  #########

Host brigitte
  User biche

  ########
  # LIP6 #
  ########

  # Used to forward the ports for jupyter notebooks
Host *jupyter
  LocalForward 8888 localhost:8888
  #RemoteCommand tmux set-option status-bg cyan
  PermitLocalCommand yes
  LocalCommand ssh %r@%h 'grep -m1 -o "http://localhost:[0-9]*/[^ ]*" ~/.local/share/jupyter.log' | xargs xdg-open &> /dev/null

Host *marimo
  LocalForward 8888 localhost:8888
  PermitLocalCommand yes
  LocalCommand ssh %r@%h 'grep -m1 -o "http://localhost:[0-9]*/[^ ]*" ~/.local/share/marimo.log' | xargs xdg-open &> /dev/null

  # Only use tunnel server if the server is not directly accesible
Match !host "ducas" exec "tmp=%h; ! ping ${tmp/-*/} -c 1 &> /dev/null"
  ProxyJump ducas

  # Tunneling machine
Host ducas
  User barbaza
  Hostname ducas.lip6.fr

Host ubuntu*
  Hostname flcian02
  User barbaza

Host fox*
  Hostname fox
  User barbaza

Host bip*
