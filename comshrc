#############
# functions #
#############

ssprint() {

  while [[ $# -gt 0 ]]; do
    case $1 in
      -s|--staples)
      local staple="-o Staple=StapleON -o StapleLocation=SinglePortrait"
      shift
      ;;
  --help)
    local help="--help"
    shift
    ;;
  *)
    if [ -f "$1" ]; then
      local files="$files $1"
        elif ssh $1 exit &> /dev/null ; then

        local host=$1
    else
      pos_args+=("$1") # save positional arg
        fi
        shift # past argument
        ;;
  esac
    done
    if [ -z "$host" ] ; then
      echo "Error : No server was specified"

    else
      if [ -z "$files" ] ; then
        echo "Error : No file was specified"
      else
        set -o shwordsplit

          for file in $files; do
            ssh $host lpr $pos_args $staple < $file
              done
              return 0
              fi
              fi
              echo "Usage: $funcstack[1] <host> <file> [options]"
              lpr --help | tail -n +2
              echo "-s, --staples           Staples the pages together"
}


