if [ ! -z "$(command -v eza)" ]
then
alias ls='eza'
alias ll='eza -l'
alias ll2='eza -l --tree --level=2'
alias lla='eza -la'
else
alias ls='ls --color=auto'
alias ll='ls -hlF'
alias lla='ls -hlFa'
fi

alias sdate='date +%d/%m/%y'

#############
# functions #
#############

ssprint() {
  if [ $# -lt 2 ]
    then
      local help="--help"
  else
    local host=$1
      local file=$2
      shift; shift
      while [[ $# -gt 0 ]]; do
        case $1 in
          -s|--staples)
          local staple="-o Staple=StapleON -o StapleLocation=SinglePortrait"
          shift
          ;;
  --help)
    local help="--help"
    shift
    ;;
  *)
    pos_args+=("$1") # save positional arg
    shift # past argument
    ;;
  esac
    done
    fi
    if [ -z "$help" ]; then
      ssh $host lpr $pos_args $staple < $file
    else
      echo "Usage: $funcstack[1] <host> <file> [options]"
        lpr $help | tail -n +2
        echo "-s, --staples           Staples the pages together"
        fi
}


